// 1. Firebase Imports
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

// 2. Your Firebase Configuration
const firebaseConfig = {
  apiKey: "AIzaSyBgTr-cByidGG54_rjJGoMGZHL6_aAWEdO",
  authDomain: "itech-survey-form-database.firebaseapp.com",
  projectId: "itech-survey-form-database",
  storageBucket: "itech-survey-form-database.firebasestorage.app",
  messagingSenderId: "386902674261",
  appId: "1:386902674261:web:fad872eaf0eac211a1bddc",
  measurementId: "G-2P22516MTX"
};

// 3. Initialize Firebase & Firestore
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

// 4. Navigation Function
function showSection(sectionId) {
    document.querySelectorAll('.section').forEach(sec => {
        sec.style.display = 'none';
    });

    document.getElementById(sectionId).style.display = 'block';

    const btn = document.getElementById('surveybtn');

    if (sectionId === 'surveydiv') {
        btn.style.display = 'none';
    } else {
        btn.style.display = 'block';
    }
}

// 5. CRITICAL: Make the function visible to your HTML buttons
window.showSection = showSection;

// 6. Handle Form Submission (Capturing ALL inputs)
const submitBtn = document.getElementById('submitbtn');

submitBtn.addEventListener('click', async (e) => {
    e.preventDefault();

    // A. Capture Question 1: Checkboxes (Issues)
    const issueCheckboxes = document.querySelectorAll('input[name="issues[]"]:checked');
    const selectedIssues = Array.from(issueCheckboxes).map(cb => cb.parentElement.textContent.trim());
    const issuesOther = document.querySelector('input[name="issues_other"]').value;

    // B. Capture Question 2: Radio (Hangout Spot) + Checkboxes (Preference)
    const favoriteSpot = document.querySelector('input[name="q2r1"]:checked')?.parentElement.textContent.trim() || "None";
    const preferenceCheckboxes = document.querySelectorAll('input[name="preference[]"]:checked');
    const preferences = Array.from(preferenceCheckboxes).map(cb => cb.parentElement.textContent.trim());

    // C. Capture Questions 5-11: Radio Ratings (Ratings)
    // Helper function to get radio value safely
    const getRadioValue = (name) => document.querySelector(`input[name="${name}"]:checked`)?.parentElement.textContent.trim() || "No Rating";

    const feedbackData = {
        // Personal Info
        name: document.getElementById('anon').checked ? "Anonymous" : document.getElementById('name').value,
        email: document.getElementById('email').value,
        
        // Survey Answers
        classroomIssues: selectedIssues,
        classroomIssuesOther: issuesOther,
        favoriteSpot: favoriteSpot,
        factorsForPreference: preferences,
        
        // Ratings (Using the names from your HTML)
        crMaintenance: getRadioValue('q5r1'),
        crFixtures: getRadioValue('q6r2'),
        crPrivacy: getRadioValue('q7r3'),
        crWaterSupply: getRadioValue('q8r4'),
        instructorAbility: getRadioValue('q9r5'),
        curriculumFocus: getRadioValue('q10r6'),
        workEthics: getRadioValue('q11r7'),
        
        // Suggestion
        suggestion: document.getElementById('q12c1').value,
        
        submittedAt: new Date()
    };

    try {
        await addDoc(collection(db, "responses"), feedbackData);
        alert("Full feedback submitted successfully!");
        showSection('resultdiv');
    } catch (error) {
        console.error("Submission Error: ", error);
    }
});

// 7. Fetch and Display Results
async function loadResults() {
    const tableBody = document.getElementById('tableBody');
    if (!tableBody) return;
    
    tableBody.innerHTML = "<tr><td colspan='3'>Loading results...</td></tr>";

    try {
        const querySnapshot = await getDocs(collection(db, "responses"));
        tableBody.innerHTML = ""; // Clear loading message

        querySnapshot.forEach((doc) => {
            const data = doc.data();
            // Convert Firebase timestamp to readable date
            const date = data.submittedAt ? data.submittedAt.toDate().toLocaleString() : "N/A";
            
            const row = `
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">${data.name}</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">${data.email}</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">${date}</td>
                </tr>
            `;
            tableBody.innerHTML += row;
        });
    } catch (error) {
        console.error("Error fetching results: ", error);
        tableBody.innerHTML = "<tr><td colspan='3'>Error loading data.</td></tr>";
    }
}